<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Prevent loops: If the request is for an existing file or directory, stop.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Handle "/index" specifically: Serve index.html without external redirect.
    RewriteRule ^index$ index.html [L]

    # 3. Handle other clean URLs: Remove .html for other files.
    # Example: /page -> /page.html
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>

# Fallback to index.html for any directory request
DirectoryIndex index.html

# Prevent directory listing
Options -Indexes